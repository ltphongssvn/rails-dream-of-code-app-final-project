# .gitignore
# Path: /rails-dream-of-code-app-final-project/.gitignore

# Bundler
/.bundle
/vendor/bundle

# Database
/db/*.sqlite3
/db/*.sqlite3-*

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Storage (Active Storage files)
/storage/*
!/storage/.keep
/public/uploads

# Master key (never commit this!)
/config/master.key
/config/credentials/*.key

# Environment files
.env
.env.*
!.env.example

# IDE directories and files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Test coverage
/coverage/

# Node modules (if using Webpacker/JS bundling)
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Public assets
/public/assets
/public/packs
/public/packs-test

# Ignore uploaded files in development
/public/system

# Ignore precompiled javascript packs
/public/packs
/public/packs-test

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity
