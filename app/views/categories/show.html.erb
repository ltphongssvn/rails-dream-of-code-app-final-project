<%# app/views/categories/show.html.erb %>
<div class="container mx-auto px-4 py-8">
  <%# Header with back link and action buttons %>
  <div class="mb-6">
    <%= link_to "← Back to Categories", categories_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-8 mb-6">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center space-x-4">
        <div class="w-12 h-12 rounded-full border-2 border-gray-300" style="background-color: <%= @category.color %>;"></div>
        <div>
          <h1 class="text-3xl font-bold text-gray-800"><%= @category.name %></h1>
          <% if @category.parent_category %>
            <p class="text-gray-600 mt-1">
              Subcategory of <%= link_to @category.parent_category.name, category_path(@category.parent_category), class: "text-blue-600 hover:text-blue-800" %>
            </p>
          <% else %>
            <p class="text-gray-600 mt-1">Top-level category</p>
          <% end %>
        </div>
      </div>

      <div class="flex space-x-2">
        <%= link_to "Edit", edit_category_path(@category), class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
        <%= button_to "Delete", category_path(@category), method: :delete,
            data: { confirm: "Are you sure you want to delete this category?" },
            class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" %>
      </div>
    </div>

    <%# Statistics section %>
    <div class="border-t border-gray-200 pt-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Time Usage This Month</h2>
      <div class="bg-blue-50 rounded-lg p-4">
        <div class="text-3xl font-bold text-blue-600">
          <%= (@total_time_this_month / 60.0).round(1) %> hours
        </div>
        <p class="text-gray-600 text-sm mt-1">
          <%= @total_time_this_month %> minutes total (including subcategories)
        </p>
      </div>
    </div>
  </div>

  <%# Subcategories section %>
  <% if @subcategories.any? %>
    <div class="bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Subcategories</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <% @subcategories.each do |subcategory| %>
          <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-full border-2 border-gray-300" style="background-color: <%= subcategory.color %>;"></div>
              <div class="flex-1">
                <h3 class="font-semibold text-gray-800">
                  <%= link_to subcategory.name, category_path(subcategory), class: "hover:text-blue-600" %>
                </h3>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Recent time entries section %>
  <% if @recent_entries.any? %>
    <div class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Recent Time Entries</h2>
      <div class="space-y-3">
        <% @recent_entries.each do |entry| %>
          <div class="border-l-4 pl-4 py-2" style="border-color: <%= @category.color %>;">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-semibold text-gray-800">
                  <%= entry.date.strftime("%B %d, %Y") %> at <%= entry.hour %>:00
                </p>
                <p class="text-gray-600 text-sm">
                  <%= entry.duration_minutes %> minutes
                  <% if entry.notes.present? %>
                    - <%= entry.notes %>
                  <% end %>
                </p>
              </div>
              <%= link_to "View", time_entries_path(date: entry.date), class: "text-blue-600 hover:text-blue-800 text-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-md p-8 text-center">
      <p class="text-gray-600">No time entries for this category yet</p>
    </div>
  <% end %>
</div>
