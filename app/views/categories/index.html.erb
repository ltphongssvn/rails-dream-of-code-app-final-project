<%# app/views/categories/index.html.erb %>
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800">My Categories</h1>
    <%= link_to "New Category", new_category_path, class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
  </div>

  <% if @categories.any? %>
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="divide-y divide-gray-200">
        <% @categories.each do |category| %>
          <div class="p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <%# Color indicator %>
                <div class="w-6 h-6 rounded-full border-2 border-gray-300" style="background-color: <%= category.color %>;"></div>
                
                <div>
                  <h3 class="text-lg font-semibold text-gray-800">
                    <%= link_to category.name, category_path(category), class: "hover:text-blue-600" %>
                  </h3>
                  
                  <%# Show subcategories if any %>
                  <% if category.subcategories.any? %>
                    <div class="mt-2 ml-8 space-y-1">
                      <% category.subcategories.each do |subcategory| %>
                        <div class="flex items-center space-x-2 text-sm">
                          <div class="w-4 h-4 rounded-full border border-gray-300" style="background-color: <%= subcategory.color %>;"></div>
                          <span class="text-gray-600">
                            <%= link_to subcategory.name, category_path(subcategory), class: "hover:text-blue-600" %>
                          </span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center space-x-2">
                <%= link_to "View", category_path(category), class: "text-blue-600 hover:text-blue-800" %>
                <span class="text-gray-300">|</span>
                <%= link_to "Edit", edit_category_path(category), class: "text-green-600 hover:text-green-800" %>
                <span class="text-gray-300">|</span>
                <%= button_to "Delete", category_path(category), method: :delete, 
                    data: { confirm: "Are you sure you want to delete this category?" },
                    class: "text-red-600 hover:text-red-800" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <div class="text-gray-400 text-6xl mb-4">📁</div>
      <h2 class="text-xl font-semibold text-gray-700 mb-2">No categories yet</h2>
      <p class="text-gray-600 mb-6">
        Create your first category to start organizing your time entries
      </p>
      <%= link_to "Create Category", new_category_path, class: "inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors" %>
    </div>
  <% end %>
</div>
