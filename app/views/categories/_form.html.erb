<%# app/views/categories/_form.html.erb %>
<%= form_with(model: category, local: true, class: "space-y-6") do |form| %>
  <%# Display validation errors if any %>
  <% if category.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h3 class="text-red-800 font-semibold mb-2">
        <%= pluralize(category.errors.count, "error") %> prevented this category from being saved:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Category name field %>
  <div>
    <%= form.label :name, "Category Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.text_field :name, 
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        placeholder: "e.g., Work, Study, Exercise" %>
    <p class="mt-1 text-sm text-gray-500">Give your category a clear, descriptive name</p>
  </div>

  <%# Color picker field %>
  <div>
    <%= form.label :color, "Color", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <div class="flex items-center space-x-4">
      <%= form.color_field :color,
          class: "h-12 w-20 cursor-pointer rounded-lg border-2 border-gray-300" %>
      <div class="flex-1">
        <%= form.text_field :color,
            class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
            placeholder: "#3B82F6" %>
      </div>
    </div>
    <p class="mt-1 text-sm text-gray-500">Choose a color to visually identify this category (or leave blank for random)</p>
  </div>

  <%# Parent category selection %>
  <div>
    <%= form.label :parent_category_id, "Parent Category (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.select :parent_category_id,
        options_from_collection_for_select(@available_parents, :id, :name, category.parent_category_id),
        { include_blank: "None - Make this a top-level category" },
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    <p class="mt-1 text-sm text-gray-500">
      Select a parent to create a subcategory (e.g., "Rails" under "Learning")
    </p>
  </div>

  <%# Form actions %>
  <div class="flex items-center justify-between pt-6 border-t border-gray-200">
    <%= link_to "Cancel", categories_path, 
        class: "px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    <%= form.submit class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
