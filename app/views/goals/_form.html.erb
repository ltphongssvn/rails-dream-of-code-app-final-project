<%# app/views/goals/_form.html.erb %>
<%= form_with(model: goal, local: true, class: "space-y-6") do |form| %>
  <%# Display validation errors if any %>
  <% if goal.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h3 class="text-red-800 font-semibold mb-2">
        <%= pluralize(goal.errors.count, "error") %> prevented this goal from being saved:
      </h3>
      <ul class="list-disc list-inside text-red-700">
        <% goal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Goal Type Selection %>
  <div>
    <%= form.label :goal_type, "Goal Type", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.select :goal_type,
        options_for_select([
          ['Daily - Track every day', 'daily'],
          ['Weekly - Track over a week', 'weekly'],
          ['Specific Hour - Track at a particular time', 'specific_hour']
        ], goal.goal_type),
        {},
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        onchange: "toggleHourField(this.value)" %>
    <p class="mt-1 text-sm text-gray-500">Choose how you want to track this goal</p>
  </div>

  <%# Target Minutes %>
  <div>
    <%= form.label :target_minutes, "Target Minutes", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.number_field :target_minutes,
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        placeholder: "60",
        min: 1,
        max: 1440 %>
    <p class="mt-1 text-sm text-gray-500">How many minutes do you want to achieve? (1-1440)</p>
  </div>

  <%# Category Selection %>
  <div>
    <%= form.label :category_id, "Category (Optional)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.select :category_id,
        options_from_collection_for_select(@categories, :id, :name, goal.category_id),
        { include_blank: "None - General goal not tied to a category" },
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    <p class="mt-1 text-sm text-gray-500">
      Link this goal to a specific category to track time automatically
    </p>
  </div>

  <%# Hour Field (only for specific_hour goals) %>
  <div id="hour-field" style="<%= goal.goal_type == 'specific_hour' ? '' : 'display:none;' %>">
    <%= form.label :hour, "Hour of Day", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <%= form.number_field :hour,
        class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        placeholder: "9",
        min: 0,
        max: 23 %>
    <p class="mt-1 text-sm text-gray-500">
      Specify the hour (0-23) for this goal, e.g., 9 for 9:00 AM
    </p>
  </div>

  <%# Days of Week Selection %>
  <div>
    <%= form.label :days_array, "Days of Week", class: "block text-sm font-semibold text-gray-700 mb-2" %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <% Goal::DAYS_OF_WEEK.each do |day| %>
        <label class="flex items-center space-x-2 cursor-pointer">
          <%= check_box_tag 'goal[days_array][]', day,
              (goal.days_array || []).include?(day),
              class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-700"><%= day %></span>
        </label>
      <% end %>
    </div>
    <p class="mt-2 text-sm text-gray-500">
      Leave all unchecked to apply this goal every day, or select specific days
    </p>
  </div>

  <%# Active Status %>
  <div class="flex items-center space-x-2">
    <%= form.check_box :active,
        class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
    <%= form.label :active, "Goal is active", class: "text-sm font-medium text-gray-700" %>
    <p class="text-sm text-gray-500">(Inactive goals won't be tracked but will be preserved)</p>
  </div>

  <%# Form Actions %>
  <div class="flex items-center justify-between pt-6 border-t border-gray-200">
    <%= link_to "Cancel", goals_path,
        class: "px-6 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors" %>
    <%= form.submit class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
  </div>
<% end %>

<script>
  function toggleHourField(goalType) {
    const hourField = document.getElementById('hour-field');
    if (goalType === 'specific_hour') {
      hourField.style.display = 'block';
    } else {
      hourField.style.display = 'none';
      // Clear the hour value when hiding the field
      const hourInput = hourField.querySelector('input[type="number"]');
      if (hourInput) {
        hourInput.value = '';
      }
    }
  }
</script>