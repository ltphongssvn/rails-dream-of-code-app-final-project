<%# app/views/goals/index.html.erb %>
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800">My Goals</h1>
    <%= link_to "New Goal", new_goal_path, class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
  </div>


  <%# Active Goals Section %>
  <% if @active_goals.any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">Active Goals</h2>
      <div class="space-y-4">
        <% @active_goals.each do |goal| %>
          <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center space-x-3 mb-2">
                  <span class="px-3 py-1 text-xs font-semibold rounded-full <%= goal.goal_type == 'daily' ? 'bg-blue-100 text-blue-800' : goal.goal_type == 'weekly' ? 'bg-green-100 text-green-800' : 'bg-purple-100 text-purple-800' %>">
                    <%= goal.goal_type.titleize %>
                  </span>
                  <% if goal.category.present? %>
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                      <%= goal.category.name %>
                    </span>
                  <% end %>
                </div>

                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  <%= link_to goal_path(goal), class: "hover:text-blue-600" do %>
                    <%= goal.target_minutes %> minutes
                    <%= "of #{goal.category.name}" if goal.category.present? %>
                    <%= "at #{goal.hour}:00" if goal.hour.present? %>
                  <% end %>
                </h3>

                <% if goal.days_array.present? && goal.days_array.any? %>
                  <div class="flex flex-wrap gap-1 mt-2">
                    <% goal.days_array.each do |day| %>
                      <span class="px-2 py-1 text-xs bg-indigo-50 text-indigo-700 rounded">
                        <%= day[0..2] %>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <p class="text-sm text-gray-500">Applies every day</p>
                <% end %>

                <div class="mt-3 flex items-center space-x-4 text-sm text-gray-600">
                  <span class="flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <%= goal.current_streak %> day streak
                  </span>
                  <span>
                    <%= goal.completion_rate %>% completion rate
                  </span>
                </div>
              </div>

              <div class="flex items-center space-x-2 ml-4">
                <%= link_to "View", goal_path(goal), class: "text-blue-600 hover:text-blue-800" %>
                <span class="text-gray-300">|</span>
                <%= link_to "Edit", edit_goal_path(goal), class: "text-green-600 hover:text-green-800" %>
                <span class="text-gray-300">|</span>
                <%= button_to "Delete", goal_path(goal), method: :delete,
                    data: { confirm: "Are you sure you want to delete this goal?" },
                    class: "text-red-600 hover:text-red-800" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Inactive Goals Section %>
  <% if @inactive_goals.any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-gray-600 mb-4">Inactive Goals</h2>
      <div class="space-y-4">
        <% @inactive_goals.each do |goal| %>
          <div class="bg-gray-50 rounded-lg shadow p-6 opacity-75">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">
                  <%= goal.target_minutes %> minutes
                  <%= "of #{goal.category.name}" if goal.category.present? %>
                </h3>
                <p class="text-sm text-gray-500">
                  <%= goal.goal_type.titleize %> goal (Inactive)
                </p>
              </div>

              <div class="flex items-center space-x-2 ml-4">
                <%= link_to "View", goal_path(goal), class: "text-blue-600 hover:text-blue-800" %>
                <span class="text-gray-300">|</span>
                <%= link_to "Edit", edit_goal_path(goal), class: "text-green-600 hover:text-green-800" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Empty State %>
  <% if @active_goals.empty? && @inactive_goals.empty? %>
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <div class="text-gray-400 text-6xl mb-4">🎯</div>
      <h2 class="text-xl font-semibold text-gray-700 mb-2">No goals yet</h2>
      <p class="text-gray-600 mb-6">
        Create your first goal to start tracking your progress and building productive habits
      </p>
      <%= link_to "Create Goal", new_goal_path, class: "inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors" %>
    </div>
  <% end %>
</div>