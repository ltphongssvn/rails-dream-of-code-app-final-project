<%# app/views/registrations/new.html.erb %>
<div class="container mx-auto px-4 py-8">
  <div class="max-w-md mx-auto">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">Create Your Account</h1>

      <p class="text-gray-600 mb-6 text-center">
        Start tracking your time and achieving your goals today
      </p>

      <%# Display validation errors if any %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <h3 class="text-red-800 font-semibold mb-2">
            <%= pluralize(@user.errors.count, "error") %> prevented your account from being created:
          </h3>
          <ul class="list-disc list-inside text-red-700">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with(model: @user, url: registrations_path, local: true, class: "space-y-6") do |form| %>
        <%# Email Address Field %>
        <div>
          <%= form.label :email_address, "Email Address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.email_field :email_address,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "you@example.com",
              required: true,
              autofocus: true %>
          <p class="mt-1 text-sm text-gray-500">This will be your username for logging in</p>
        </div>

        <%# First Name Field %>
        <div>
          <%= form.label :first_name, "First Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.text_field :first_name,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "John",
              required: true,
              maxlength: 100 %>
        </div>

        <%# Last Name Field %>
        <div>
          <%= form.label :last_name, "Last Name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.text_field :last_name,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "Doe",
              required: true,
              maxlength: 100 %>
        </div>

        <%# Password Field %>
        <div>
          <%= form.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.password_field :password,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "Create a secure password",
              required: true %>
          <p class="mt-1 text-sm text-gray-500">Must be at least 8 characters long</p>
        </div>

        <%# Password Confirmation Field %>
        <div>
          <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.password_field :password_confirmation,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "Type your password again",
              required: true %>
          <p class="mt-1 text-sm text-gray-500">Must match the password above</p>
        </div>

        <%# Time Zone Field %>
        <div>
          <%= form.label :time_zone, "Time Zone", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= form.time_zone_select :time_zone,
              ActiveSupport::TimeZone.us_zones,
              { default: 'Pacific Time (US & Canada)' },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          <p class="mt-1 text-sm text-gray-500">Select your local time zone for accurate time tracking</p>
        </div>

        <%# Submit Button %>
        <div class="pt-4">
          <%= form.submit "Create Account",
              class: "w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer font-semibold" %>
        </div>
      <% end %>

      <%# Link to Login Page %>
      <div class="mt-6 text-center">
        <p class="text-gray-600">
          Already have an account?
          <%= link_to "Sign in here", new_session_path, class: "text-blue-600 hover:text-blue-800 font-semibold" %>
        </p>
      </div>
    </div>
  </div>
</div>